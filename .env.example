AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=ap-south-1

DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=
MYSQL_PORT=3306

VBL_CLIENT_ID=
VBL_CLIENT_SECRET=
VBL_API_BASE_URL=
VBL_COMPANY_CODE=
VBL_DIVISION=
VBL_DIST_CHANNEL=
VBL_CUST_GROUP=

PORT=3001

# Blob-storage mount (server path) where synced source files are archived by date.
UPLOAD_DIRECTORY_PATH=/appdir/CampusBlob/client/vegahrzaunl7avbl/vegahr-backend/
# Per-sync archive toggles: 1/true to archive that sync's file to UPLOAD_DIRECTORY_PATH, 0/false to skip.
STORE_DISTRIBUTOR_FILES=1
STORE_ROUTE_FILES=1
STORE_VISIT_DATA_FILES=1
